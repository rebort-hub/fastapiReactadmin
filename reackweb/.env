VITE_BASE_URL=/

VITE_APP_TITLE=Reackweb

VITE_APP_DESC=Reackweb is admin template

# 图标模式
VITE_ICON_PREFIX=icon

# 本地 SVG 图标组件的前缀，必须包含 VITE_ICON_PREFIX
# 为 {VITE_ICON_PREFIX}-{本地图标名称}
VITE_ICON_LOCAL_PREFIX=icon-local

# 常量路由与权限路由模式：静态 | 动态，目前为动态模式，由后端控制动态路由
VITE_AUTH_ROUTE_MODE=dynamic

# 静态认证路由主页路径，默认即可，一般不做修改
VITE_ROUTE_HOME=/home

# default menu icon
VITE_MENU_ICON=mdi:menu

# 开发模式下是否启用HTTP代理
VITE_HTTP_PROXY=Y

# 路由模式: hash | history | memory
VITE_ROUTER_HISTORY_MODE=history

# 后端服务的成功代码，当接收到此代码时，请求即为成功，后台动态路由时使用
VITE_SERVICE_SUCCESS_CODE=0

# 登出代码：强制登出无需刷新（留空；10403为权限拒绝，10401为令牌过期）
VITE_SERVICE_LOGOUT_CODES=

# 后端服务的模态框登出代码，当接收到该代码时，会通过显示模态框使用户登出
VITE_SERVICE_MODAL_LOGOUT_CODES=

# 后端服务的令牌过期代码，当接收到该代码时，系统将刷新令牌并重新发送请求
VITE_SERVICE_EXPIRED_TOKEN_CODES=10401

# 路由模式为静态时，所定义的超级角色
VITE_STATIC_SUPER_ROLE=R_SUPER

# sourcemap
VITE_SOURCE_MAP=N

# 用于区分不同域之间的存储
VITE_STORAGE_PREFIX=SR_

# 用于控制程序是否自动检测更新（Y 自动更新  N 不自动更新）
VITE_AUTOMATICALLY_DETECT_UPDATE=Y

# 后端服务基础URL，测试环境
VITE_SERVICE_BASE_URL=http://127.0.0.1:8001

# 其他后端服务基础URL，测试环境
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9528"
}`

# 在终端显示代理URL日志（Y 输出，N 不输出）
VITE_PROXY_LOG=N